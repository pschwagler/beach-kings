{
  "name": "beach-kings",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "postinstall": "node scripts/apply-dependency-patches.cjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test:dependency-compatibility": "node --test scripts/dependency-compatibility.test.cjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "baseline-browser-mapping": "^2.10.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "19.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=22.23.5"
  },
  "overrides": {
    "image-size": "npm:probe-image-size@7.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-test-renderer": "19.3.0",
    "uuid": "11.1.1",
    "shell-quote": "1.12.0",
    "@expo/fingerprint": {
      "minimatch": "^11.0.1"
    },
    "query-string": "$query-string"
  },
  "dependencies": {
    "expo": "~58.1.0",
    "patch-package": "^8.0.1",
    "query-string": "10.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.0"
  }
}
