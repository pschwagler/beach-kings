{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:8000",
        "EXPO_PUBLIC_WEB_URL": "http://localhost:3000",
        "EXPO_PUBLIC_APP_ENV": "development",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.beachleaguevb.com",
        "EXPO_PUBLIC_WEB_URL": "https://dev.beachleaguevb.com",
        "EXPO_PUBLIC_APP_ENV": "preview",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://beachleaguevb.com",
        "EXPO_PUBLIC_WEB_URL": "https://beachleaguevb.com",
        "EXPO_PUBLIC_APP_ENV": "production",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6801891670"
      }
    }
  }
}
