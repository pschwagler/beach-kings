{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "jest",
      "node",
      "@testing-library/jest-native"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "customConditions": [
      "react-native",
      "react-native-legacy-deep-imports"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ]
}
