{
  "name": "@beach-kings/mobile",
  "version": "1.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export -p ios -p android && node scripts/verify-production-no-dev-auth.js",
    "release:export:ios": "expo export --platform ios --output-dir dist",
    "release:preflight": "node scripts/release-preflight.js",
    "release:record:create": "node scripts/release-record.js create",
    "release:record:validate": "node scripts/release-record.js validate",
    "verify:production-no-dev-auth": "node scripts/verify-production-no-dev-auth.js",
    "start": "expo start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e:social": "bash scripts/run-social-e2e.sh",
    "e2e:check": "bash scripts/run-social-e2e.sh --check",
    "ios": "expo run:ios",
    "android": "expo run:android"
  },
  "dependencies": {
    "@beach-kings/api-client": "*",
    "@beach-kings/shared": "*",
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.28.1",
    "@shopify/flash-list": "~2.3.2",
    "@tanstack/react-query": "^5.99.0",
    "expo": "~58.1.0",
    "expo-apple-authentication": "~58.0.3",
    "expo-auth-session": "~58.0.20",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.9",
    "expo-declared-age-range": "file:modules/expo-declared-age-range",
    "expo-dev-client": "~58.0.22",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.19",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.23",
    "expo-notifications": "~58.1.10",
    "expo-router": "~58.0.33",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.15",
    "expo-status-bar": "~58.0.5",
    "expo-store-review": "~58.0.3",
    "expo-web-browser": "~58.1.0",
    "nativewind": "^4.1.23",
    "phosphor-react-native": "^3.0.4",
    "react": "19.3.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "supercluster": "^8.0.1",
    "tailwindcss": "^3.4.17",
    "zod": "^4.3.6",
    "expo-clipboard": "~58.0.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/plist": "0.8.1",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/supercluster": "^7.1.3",
    "axios-mock-adapter": "^2.1.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
