{
  "name": "@beach-kings/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export -p ios -p android && node scripts/verify-production-no-dev-auth.js",
    "release:export:ios": "expo export --platform ios --output-dir dist",
    "release:preflight": "node scripts/release-preflight.js",
    "release:record:create": "node scripts/release-record.js create",
    "release:record:validate": "node scripts/release-record.js validate",
    "verify:production-no-dev-auth": "node scripts/verify-production-no-dev-auth.js",
    "start": "expo start",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "e2e:social": "bash scripts/run-social-e2e.sh",
    "e2e:check": "bash scripts/run-social-e2e.sh --check",
    "ios": "expo run:ios",
    "android": "expo run:android"
  },
  "dependencies": {
    "@beach-kings/api-client": "*",
    "@beach-kings/shared": "*",
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.99.0",
    "expo": "~57.0.13",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.7",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-declared-age-range": "file:modules/expo-declared-age-range",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.10",
    "expo-linking": "~57.0.6",
    "expo-location": "~57.0.10",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.1.23",
    "phosphor-react-native": "^3.0.4",
    "react": "19.2.3",
    "react-hook-form": "^7.72.1",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "supercluster": "^8.0.1",
    "tailwindcss": "^3.4.17",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@expo/plist": "0.8.1",
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "@types/supercluster": "^7.1.3",
    "axios-mock-adapter": "^2.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
