# Beach League - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_USER=beachkings
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=beachkings
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# =============================================================================
# Application Settings
# =============================================================================
# CRITICAL: Generate a secure random key for production
# Example: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRATION_HOURS=1
# Refresh token lifetime in days (tokens rotate on each use)
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Set to "production" to disable auto-reload
ENV=development

# Public web origin used when generating shareable invite links.
# Leave unset for local development (defaults to http://localhost:FRONTEND_PORT)
# and canonical production (https://beachleaguevb.com when ENV=production).
# Set explicitly for staging, previews, LAN devices, or custom deployments.
# FRONTEND_URL=https://staging.beachleaguevb.com

# Comma-separated list of allowed CORS origins
# Production: https://beachleaguevb.com,https://dev.beachleaguevb.com
ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# WhatsApp Service (optional)
# =============================================================================
ENABLE_WHATSAPP=true

# =============================================================================
# Twilio SMS (optional)
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Set to false to disable SMS sending (default: true)
ENABLE_SMS=true

# =============================================================================
# SendGrid Email (optional)
# =============================================================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@beachleaguevb.com
ADMIN_EMAIL=admin@beachleaguevb.com
# Set to false to disable email sending (default: true)
ENABLE_EMAIL=true

# =============================================================================
# Port Configuration (usually leave as defaults)
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
WHATSAPP_PORT=3001

# In development, Next.js proxies /api to this URL. Default 8000.
# E2E sets BACKEND_PROXY_TARGET=http://localhost:8001 so the test frontend talks to the test backend.
# Not needed for production (use NEXT_PUBLIC_API_URL at build time instead).
# BACKEND_PROXY_TARGET=http://localhost:8000

# Internal URL for server-side rendering (SSR) calls from Next.js to backend.
# - Docker: http://backend:8000 (container-to-container, set in docker-compose.yml)
# - Local dev: http://localhost:8000 (same host)
# Used by server-fetch.js for sitemap, public pages, and other SSR data fetching.
BACKEND_INTERNAL_URL=http://localhost:8000


GEOAPIFY_API_KEY=MY_KEY

# =============================================================================
# Google SSO (optional)
# =============================================================================
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# =============================================================================
# Gemini (photo score extraction)
# =============================================================================
# Use GEMINI_API_KEY or GOOGLE_API_KEY
GEMINI_API_KEY=

# =============================================================================
# Google Places API (court photo discovery)
# =============================================================================
GOOGLE_PLACES_API_KEY=

# =============================================================================
# AWS S3 (avatar uploads)
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=us-west-2

# =============================================================================
# Durable UGC Moderation
# =============================================================================
# Local development may use off/shadow/enforce. Production and staging always
# behave as enforce in server code so an accidental "off" cannot publish UGC.
MODERATION_MODE=off
MODERATION_MODEL=omni-moderation-latest
MODERATION_TRIAGE_MODEL=gpt-5.6-luna
MODERATION_PROVIDER_TIMEOUT=20
MODERATION_MAX_ATTEMPTS=5
OPENAI_API_KEY=
# Separate private bucket for restricted evidence snapshots.
AWS_MODERATION_EVIDENCE_BUCKET=

# =============================================================================
# Mobile App (Expo)
# =============================================================================
# Base URL the Expo app uses to reach the backend.
# - iOS simulator: http://localhost:8000 works (shares host network).
# - Physical device via Expo Go: use your Mac's LAN IP, e.g. http://192.168.1.42:8000
#   Find it with: ipconfig getifaddr en0
# Requires BACKEND_BIND_HOST=0.0.0.0 (below) so Docker exposes the backend to the LAN.
# Only vars prefixed EXPO_PUBLIC_* are bundled into the client.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Durable Expo push delivery. Keep disabled until EXPO_ACCESS_TOKEN is stored
# server-side and enhanced Expo push security is enabled for the EAS project.
PUSH_DELIVERY_ENABLED=false
PUSH_MAX_ATTEMPTS=5
EXPO_ACCESS_TOKEN=

# Google Sign-In (mobile) — OAuth client IDs from Google Cloud Console.
# Required for the Sign Up / Sign In with Google buttons. Leave blank to disable
# (the buttons will show an "not configured" alert).
#
# Create three OAuth 2.0 Client IDs at https://console.cloud.google.com/apis/credentials
# under the same project as GOOGLE_CLIENT_ID (so backend token verification works):
#   - iOS application: bundle ID `com.beachleague.app`
#   - Android application: package `com.beachleague.app` + SHA-1 fingerprint of signing cert
#   - Web application: any (used as fallback / web target)
# Then for iOS, add the reversed client ID URL scheme to apps/mobile/app.json under
# `ios.infoPlist.CFBundleURLTypes`. See apps/mobile/docs/google-sso.md.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Bind host for the backend container's published port.
# Default 127.0.0.1 (localhost-only, secure). Set to 0.0.0.0 to expose on LAN
# for testing the mobile app on a physical device.
BACKEND_BIND_HOST=127.0.0.1

# =============================================================================
# System Admin
# =============================================================================
# Phone number (E.164 format) to seed as the default system admin on startup.
# Leave empty to skip admin seeding.
DEFAULT_ADMIN_PHONE=+15550000000
