[Unit]
Description=Archive the Beach Kings production PostgreSQL database to S3
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
EnvironmentFile=/etc/beach-kings/backup.env
WorkingDirectory=/home/ubuntu/beach-kings
ExecStart=/home/ubuntu/beach-kings/deployment/backups/backup-postgres-to-s3.sh
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/beach-kings-backups
