# Install as /etc/beach-kings/backup.env with mode 0600.
# Prefer an EC2 instance profile; do not put AWS access keys in this file.
BACKUP_S3_BUCKET=replace-with-private-backup-bucket
BACKUP_S3_PREFIX=database/production
BACKUP_AWS_REGION=us-east-1

# Normally discovered through Docker Compose. Set only for a non-Compose install.
BACKUP_POSTGRES_CONTAINER=
BACKUP_COMPOSE_PROJECT_DIR=/home/ubuntu/beach-kings
BACKUP_POSTGRES_DB=beachkings
BACKUP_POSTGRES_USER=beachkings
BACKUP_LOCAL_RETENTION_DAYS=2
BACKUP_WORK_DIR=/var/lib/beach-kings-backups

# AES256 uses S3-managed encryption. For a customer-managed key, set aws:kms
# and provide the key ARN or ID below.
BACKUP_S3_SSE=AES256
BACKUP_S3_KMS_KEY_ID=

# Optional SNS topic used for failure notifications.
BACKUP_SNS_TOPIC_ARN=
